# ============================================================
# DocuPilot - Token-Optimized Environment Configuration
# ============================================================

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
USE_MOCK_LLM=false

# Generation & Token Efficiency Parameters
MAX_OUTPUT_TOKENS=128
TEMPERATURE=0
MAX_HISTORY_MESSAGES=2

# Vector Database (Local ChromaDB)
CHROMA_PATH=./chroma_db

# Local Embedding Model (Runs 100% locally at ₹0 cost)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Adaptive Retrieval & Relevance Gating
TOP_K=5
FINAL_CONTEXT_CHUNKS=3
SIMILARITY_THRESHOLD=0.45
HIGH_RELEVANCE_THRESHOLD=0.60
STRONG_RELEVANCE_THRESHOLD=0.50

# Ingestion & Chunking (Character-based)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Upload Limits
MAX_FILE_SIZE_MB=10

# Application Environment
ENV=development
PORT=8000
HOST=0.0.0.0
